# Udyog Sathi — Environment Configuration Template (.env.example)
# Copy this file to .env and provide local values. NEVER commit .env to version control.

# Application Configuration
APP_ENV=development
APP_SECRET_KEY=replace-with-a-secure-random-secret-key-at-least-32-chars
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000

# Database Configuration (PostgreSQL + pgvector)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/udyog_sathi
DATABASE_POOL_SIZE=10

# Document & Vault Storage
DOCUMENT_STORAGE_PATH=./data/raw
DOCUMENT_STORAGE_BUCKET=
DOCUMENT_STORAGE_ENDPOINT=

# Ingestion & OCR Configuration
SCHEME_SOURCE_ALLOWLIST=msme.odisha.gov.in,odishamsme.nic.in,msme.gov.in,myscheme.gov.in
INGESTION_USER_AGENT=Mozilla/5.0 (Macintosh; Intel Mac OS X 10_15_7) UdyogSathiBot/1.0 (MSME Odisha Scheme Discovery; contact@udyogsathi.odisha.gov.in)
OCR_LANGUAGE_DATA=ori,hin,eng
OCR_CONFIDENCE_THRESHOLD=60.0

# AI Provider Credentials (Server-side only; leave blank if unavailable)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

SARVAM_API_KEY=
SARVAM_MODEL_OR_PIPELINE=saaras:v2

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# AI Gateway Runtime Policy
AI_PRIMARY_PROVIDER=groq
AI_REQUEST_TIMEOUT_SECONDS=15
AI_MAX_RETRIES=2
AI_DAILY_BUDGET=100.0

# Retrieval & Embeddings
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
VECTOR_DIMENSIONS=384

# Admin Bootstrap
ADMIN_BOOTSTRAP_EMAIL=admin@udyogsathi.odisha.gov.in

# Observability
SENTRY_DSN=
LOG_LEVEL=INFO
OTEL_EXPORTER_OTLP_ENDPOINT=
